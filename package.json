{
  "name": "nexus",
  "version": "0.1.0",
  "description": "A macOS terminal with a window-level AI assistant.",
  "author": "Reece Hunter",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/reecehunter/nexus.git"
  },
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "tauri": "tauri",
    "app:dev": "tauri dev",
    "app:build": "tauri build --bundles app",
    "check": "tsc -b && vitest run",
    "format": "prettier --write src vite.config.ts && cargo fmt --manifest-path src-tauri/Cargo.toml",
    "app:release": "node scripts/build-release.mjs",
    "test:release": "node --test scripts/release-checks.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-dialog": "^2.0.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^5.5.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.0.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "jsdom": "^26.0.0",
    "prettier": "^3.9.9",
    "typescript": "~5.9.0",
    "vite": "^6.0.0",
    "vitest": "^5.0.3"
  }
}
